    {
      "name": "choisir_event",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Choisir un événement aléatoire\", function () {\r",
              "\r",
              "    let events = pm.response.json().events;\r",
              "\r",
              "    let randomIndex = Math.floor(Math.random() * events.length);\r",
              "\r",
              "    let randomEvent = events[randomIndex];\r",
              "\r",
              "    pm.collectionVariables.set(\"eventId\", randomEvent.id);\r",
              "    pm.collectionVariables.set(\"eventName\", randomEvent.nomEven);\r",
              "\r",
              "    console.log(\"Événement choisi :\", randomEvent.nomEven);\r",
              "    console.log(\"ID choisi :\", randomEvent.id);\r",
              "    pm.expect(randomEvent).to.exist;\r",
              "\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
